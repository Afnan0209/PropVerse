# Backend settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=propverse
DB_POOL_SIZE=3
ADMIN_USER=prop_admin
ADMIN_PASS=replace-with-admin-database-password
MANAGER_USER=property_manager
MANAGER_PASS=replace-with-manager-database-password
STAFF_USER=maintenance_staff
STAFF_PASS=replace-with-staff-database-password
OWNER_USER=prop_owner
OWNER_PASS=replace-with-owner-database-password
TENANT_USER=prop_tenant
TENANT_PASS=replace-with-tenant-database-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Optional: path to the CA certificate for a TLS-enabled MySQL service.
# DB_SSL_CA=C:\path\to\mysql-ca.pem

# Frontend setting (the only Vite environment variable used by the app)
VITE_API_URL=http://localhost:8000
